# ── API
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=true
DATABASE_URL=postgres://doomsday_app:troque@localhost:5432/doomsdayvote
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute
SECTIONS_PAGE_SIZE_DEFAULT=50
SECTIONS_PAGE_SIZE_MAX=200

# ── Worker de carga
BWEB_INPUT_DIR=./data/bweb
BWEB_STORAGE_DIR=./data/storage

# ── Migrações
DATABASE_MIGRATION_URL=postgres://doomsday_owner:troque@localhost:5432/doomsdayvote

# ── Testes de integração
TEST_DATABASE_URL=postgres://doomsday_app:troque@localhost:5432/doomsdayvote_test
TEST_DATABASE_MIGRATION_URL=postgres://doomsday_owner:troque@localhost:5432/doomsdayvote_test

# ── Setup nativo do banco (executar uma vez como superusuário)
POSTGRES_PASSWORD=postgres
DOOMSDAY_OWNER_PASSWORD=troque
DOOMSDAY_APP_PASSWORD=troque
