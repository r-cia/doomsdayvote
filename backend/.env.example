# ── API
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=true
DATABASE_URL=postgres://doomsday_app:troque@localhost:5433/doomsdayvote
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute
SECTIONS_PAGE_SIZE_DEFAULT=50
SECTIONS_PAGE_SIZE_MAX=200

# ── Worker de carga
BWEB_INPUT_DIR=./data/bweb
BWEB_STORAGE_DIR=./data/storage

# ── Migrações
DATABASE_MIGRATION_URL=postgres://doomsday_owner:troque@localhost:5433/doomsdayvote

# ── Testes de integração
TEST_DATABASE_URL=postgres://doomsday_app:troque@localhost:5433/doomsdayvote_test
TEST_DATABASE_MIGRATION_URL=postgres://doomsday_owner:troque@localhost:5433/doomsdayvote_test

# ── Docker Compose
POSTGRES_PASSWORD=troque
DOOMSDAY_OWNER_PASSWORD=troque
DOOMSDAY_APP_PASSWORD=troque
POSTGRES_HOST_PORT=5433
WEB_PORT=80
