{
  "name": "doomsdayvote-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --max-old-space-size=30720 --stack-size=32000 --env-file-if-exists=.env --watch src/server.js",
    "start": "node --max-old-space-size=30720 --stack-size=32000 --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/scripts/migrate.js",
    "migrate:reset": "node --env-file-if-exists=.env src/scripts/migrate.js --reset",
    "test": "vitest run",
    "purge:originais": "node --env-file-if-exists=.env src/scripts/purge-originais.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "carga": "node --max-old-space-size=30720 --stack-size=32000 --env-file-if-exists=.env src/scripts/carregar-pasta.js",
    "seed:cores": "node --env-file-if-exists=.env src/scripts/seed-cores.js",
    "cores:pendentes": "node --env-file-if-exists=.env src/scripts/cores-pendentes.js",
    "geo:carregar": "node --env-file-if-exists=.env src/scripts/geo-carregar.js"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "kysely": "^0.28.2",
    "pg": "^8.13.1",
    "pg-copy-streams": "^7.0.0",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.5",
    "mapshaper": "^0.7.101",
    "vitest": "^3.0.5"
  }
}
