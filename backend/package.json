{
  "name": "doomsdayvote-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --max-old-space-size=16384 --stack-size=16000 --env-file-if-exists=.env --watch src/server.js",
    "start": "node --max-old-space-size=16384 --stack-size=16000 --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/scripts/migrate.js",
    "migrate:reset": "node --env-file-if-exists=.env src/scripts/migrate.js --reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.js",
    "carga": "node --max-old-space-size=16384 --stack-size=16000 --env-file-if-exists=.env src/scripts/carregar-pasta.js",
    "carga:paralelo": "sh -c 'export DB_POOL_MAX=\"${POOL:-4}\"; p=\"${PASTA:-/mnt/storage/vote/bweb/2022}\"; find \"$p\" -maxdepth 1 -type f \\( -name \"*.csv\" -o -name \"*.txt\" -o -name \"*.csv.gz\" -o -name \"*.txt.gz\" -o -name \"*.csv.7z\" -o -name \"*.txt.7z\" \\) -printf \"%f\\n\" | xargs -P \"${WORKERS:-6}\" -I{} npm run --silent carga -- --pasta \"$p\" --arquivo {}; npm run --silent carga -- --pasta \"$p\"'",
    "totalizacao:carregar": "node --max-old-space-size=16384 --stack-size=16000 --env-file-if-exists=.env src/scripts/totalizacao-carregar.js",
    "totalizacao:carregar:paralelo": "sh -c 'export DB_POOL_MAX=\"${POOL:-4}\"; p=\"${PASTA:-/mnt/storage/vote/bu/2026}\"; find \"$p\" -maxdepth 1 -name \"*.zip\" -printf \"%f\\n\" | xargs -P \"${WORKERS:-6}\" -I{} npm run --silent totalizacao:carregar -- --pasta \"$p\" --arquivo {}'",
    "seed:cores": "node --env-file-if-exists=.env src/scripts/seed-cores.js",
    "cores:pendentes": "node --env-file-if-exists=.env src/scripts/cores-pendentes.js",
    "carga:status": "node --env-file-if-exists=.env src/scripts/carga-status.js",
    "geo:carregar": "node --env-file-if-exists=.env src/scripts/geo-carregar.js",
    "bu:baixar": "node --env-file-if-exists=.env src/scripts/baixar-bu.js",
    "bweb:baixar": "node --env-file-if-exists=.env src/scripts/baixar-bweb.js",
    "result:baixar": "node --env-file-if-exists=.env src/scripts/baixar-result.js"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "kysely": "^0.28.2",
    "pg": "^8.13.1",
    "pg-copy-streams": "^7.0.0",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.5",
    "mapshaper": "^0.7.101",
    "vitest": "^3.0.5"
  }
}
