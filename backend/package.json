{
  "name": "doomsdayvote-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/scripts/migrate.js",
    "migrate:reset": "node --env-file-if-exists=.env src/scripts/migrate.js --reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.js"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "kysely": "^0.28.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.5",
    "vitest": "^3.0.5"
  }
}
